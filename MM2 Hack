                    lbl.Font = Enum.Font.GothamBold
                    lbl.TextSize = 9
                    Instance.new("UICorner", lbl).CornerRadius = UDim.new(0, 4)
                end
            end
        end
    end
end

-- 12. Otomatik Coin Toplayıcı
local function runAutoFarm()
    if not autoFarmActive or not isRunning then return end
    local activeCoins = getActiveCoins()
    if #activeCoins == 0 then return end

    for _, coin in ipairs(activeCoins) do
        if not autoFarmActive or not isRunning then break end
        if coin and coin.Parent then
            for _, player in ipairs(Players:GetPlayers()) do
                if autoFarmActive and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    player.Character.HumanoidRootPart.CFrame = coin.CFrame
                    task.wait(0.25)
                end
            end
        end
    end
end

-- 13. Dinleyiciler ve Başlatma
local function bindEvents(player)
    local function watch(container)
        container.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then task.wait(0.1); refreshRoles() end
        end)
        container.ChildRemoved:Connect(function(child)
            if child:IsA("Tool") then task.wait(0.1); refreshRoles() end
        end)
    end

    player.CharacterAdded:Connect(function(char)
        watch(char)
        local backpack = player:WaitForChild("Backpack", 5)
        if backpack then watch(backpack) end
    end)

    if player.Character then watch(player.Character) end
    local backpack = player:FindFirstChild("Backpack")
    if backpack then watch(backpack) end
end

for _, p in ipairs(Players:GetPlayers()) do
    task.spawn(buildGui, p)
    bindEvents(p)
end

Players.PlayerAdded:Connect(function(p)
    buildGui(p)
    bindEvents(p)
end)

task.spawn(function()
    while isRunning do
        pcall(refreshRoles)
        pcall(scanDroppedGuns)
        pcall(runAutoFarm)
        task.wait(0.8)
    end
end)
