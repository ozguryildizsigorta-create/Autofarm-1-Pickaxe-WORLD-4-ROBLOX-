-- 1. Rol Doğrulama Fonksiyonu
local function getRole(player)
    local char = player.Character
    local backpack = player:FindFirstChild("Backpack")

    local function checkContainer(container)
        if not container then return nil end
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") then
                local name = string.lower(item.Name)
                if name == "knife" or name == "bıçak" or name == "bicak" or name == "blade" then
                    return "Katil"
                elseif name == "gun" or name == "revolver" or name == "silah" or name == "luger" or name == "sheriff" then
                    return "Şerif"
                end
            end
        end
        return nil
    end

    local foundRole = checkContainer(char) or checkContainer(backpack)
    if foundRole == "Katil" then
        return "Katil", Color3.fromRGB(235, 60, 60), Color3.fromRGB(60, 20, 20)
    elseif foundRole == "Şerif" then
        return "Şerif", Color3.fromRGB(60, 150, 255), Color3.fromRGB(20, 35, 60)
    else
        return "Masum", Color3.fromRGB(60, 220, 100), Color3.fromRGB(20, 50, 35)
    end
end

-- 2. Çantadaki/Eldeki Silahı Otomatik Kuşanma (Equip) Fonksiyonu
local function autoEquipWeapon(player, weaponType)
    local char = player.Character
    local backpack = player:FindFirstChild("Backpack")
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not humanoid or humanoid.Health <= 0 then return nil end

    -- Zaten elde takılı mı kontrol et
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") then
            local name = string.lower(item.Name)
            if weaponType == "Knife" and (name:find("knife") or name:find("bicak") or name:find("bıçak") or name:find("blade")) then
                return item
            elseif weaponType == "Gun" and (name:find("gun") or name:find("revolver") or name:find("silah") or name:find("sheriff")) then
                return item
            end
        end
    end

    -- Çantada ise karaktere tak (Equip)
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                local name = string.lower(item.Name)
                if weaponType == "Knife" and (name:find("knife") or name:find("bicak") or name:find("bıçak") or name:find("blade")) then
                    humanoid:EquipTool(item)
                    task.wait(0.1)
                    return item
                elseif weaponType == "Gun" and (name:find("gun") or name:find("revolver") or name:find("silah") or name:find("sheriff")) then
                    humanoid:EquipTool(item)
                    task.wait(0.1)
                    return item
                end
            end
        end
    end

    return nil
end

-- 3. Haritada Düşen Silahı Bulma
local function getDroppedGunPart()
    for _, item in ipairs(Workspace:GetChildren()) do
        local lName = string.lower(item.Name)
        if lName == "gundrop" or (item:IsA("Tool") and (lName == "gun" or lName == "revolver")) then
            local part = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart")
            if part then return part end
        end
    end
    return nil
end

-- 4. En Yakın Zemin Üstü Pozisyonu Hesaplama
local function getHighestSurfaceCFrame(targetPos)
    local nearestPart = nil
    local minDistance = math.huge

    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("BasePart") then
            local dist = (obj.Position - targetPos).Magnitude
            if dist < minDistance then
                minDistance = dist
                nearestPart = obj
            end
        elseif obj:IsA("Model") then
            local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if primary then
                local dist = (primary.Position - targetPos).Magnitude
                if dist < minDistance then
                    minDistance = dist
                    nearestPart = primary
                end
            end
        end
    end

    if nearestPart then
        local topY = nearestPart.Position.Y + (nearestPart.Size.Y / 2) + 3.5
        return CFrame.new(nearestPart.Position.X, topY, nearestPart.Position.Z)
    end

    return CFrame.new(targetPos + Vector3.new(0, 4, 0))
end

-- 5. Haritadaki Aktif Coinleri Bulma
local function getActiveCoins()
    local coins = {}
    for _, model in ipairs(Workspace:GetChildren()) do
        if model:IsA("Model") or model:IsA("Folder") then
            local coinFolder = model:FindFirstChild("CoinContainer") or model:FindFirstChild("CoinServer") or model:FindFirstChild("Coins")
            if coinFolder then
                for _, c in ipairs(coinFolder:GetChildren()) do
                    if c:IsA("BasePart") then table.insert(coins, c) end
                end
            else
                for _, part in ipairs(model:GetChildren()) do
                    local lName = string.lower(part.Name)
                    if part:IsA("BasePart") and (lName:find("coin") or lName == "coin_server") then
                        table.insert(coins, part)
                    end
                end
            end
        elseif model:IsA("BasePart") then
            local lName = string.lower(model.Name)
            if lName == "coin" or lName == "coin_server" then
                table.insert(coins, model)
            end
        end
    end
    return coins
end

-- 6. Katil Yeteneği: Bıçağı Çıkarıp Sırayla Herkesi Öldürme ve Geri Dönüş
local function teleportAndEliminateAll(killerPlayer)
    if getRole(killerPlayer) ~= "Katil" then return end

    local killerChar = killerPlayer.Character
    if not killerChar or not killerChar:FindFirstChild("HumanoidRootPart") then return end

    local killerHum = killerChar:FindFirstChild("Humanoid")
    local killerRoot = killerChar.HumanoidRootPart
    local originalCFrame = killerRoot.CFrame

    -- Bıçağı ele al
    local knife = autoEquipWeapon(killerPlayer, "Knife")

    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= killerPlayer and killerHum and killerHum.Health > 0 then
            local targetChar = target.Character
            local targetHum = targetChar and targetChar:FindFirstChild("Humanoid")
            local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")

            if targetHum and targetHum.Health > 0 and targetRoot then
                -- Hedefin arkasına ışınlan
                killerRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 2)
                
                -- Bıçağı salla / tetikle
                if knife then
                    knife:Activate()
                end
                targetHum:TakeDamage(100) -- Tam hasar ver
                
                task.wait(0.2)
            end
        end
    end

    -- Başlangıç konumuna geri dön
    if killerChar and killerRoot and killerHum and killerHum.Health > 0 then
        task.wait(0.1)
        killerRoot.CFrame = originalCFrame
    end
end

-- 7. Şerif Yeteneği: Silahı Ele Alıp Katili Vurma ve Geri Dönüş
local function teleportAndShootMurderer(sheriffPlayer)
    if getRole(sheriffPlayer) ~= "Şerif" then return end

    local sheriffChar = sheriffPlayer.Character
    if not sheriffChar or not sheriffChar:FindFirstChild("HumanoidRootPart") then return end

    local sheriffHum = sheriffChar:FindFirstChild("Humanoid")
    local sheriffRoot = sheriffChar.HumanoidRootPart
    local originalCFrame = sheriffRoot.CFrame

    -- Silahı ele al
    local gun = autoEquipWeapon(sheriffPlayer, "Gun")

    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= sheriffPlayer and getRole(target) == "Katil" then
            local targetChar = target.Character
            local targetHum = targetChar and targetChar:FindFirstChild("Humanoid")
            local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")

            if targetHum and targetHum.Health > 0 and targetRoot and sheriffHum and sheriffHum.Health > 0 then
                -- Katilin arkasına ışınlanıp nişan al
                sheriffRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
                
                -- Silahı ateşle / tetikle
                if gun then
                    gun:Activate()
                end
                targetHum:TakeDamage(100) -- Katili ele
                
                task.wait(0.2)

                -- Başlangıç konumuna geri dön
                if sheriffChar and sheriffRoot and sheriffHum and sheriffHum.Health > 0 then
                    task.wait(0.1)
                    sheriffRoot.CFrame = originalCFrame
                end
                break
            end
        end
    end
end

-- 8. Düşen Silaha Işınlanıp Alıp Geri Dönme Fonksiyonu
local function teleportAndGrabGun(player)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local root = char.HumanoidRootPart
    local hum = char:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then return end

    local gunPart = getDroppedGunPart()
    if gunPart then
        local originalCFrame = root.CFrame
        root.CFrame = gunPart.CFrame
        task.wait(0.25)

        if char and root and hum and hum.Health > 0 then
            root.CFrame = originalCFrame
        end
    end
end

